  "workspaceSettings": {
    "modid": "power",
    "modName": "Keepers of the Stones II",
    "version": "2.0.0",
    "description": "Keepers of the Stones II is a mod created as a continuation of the original version of the Keepers of the Stones mod. It adds more new elemental stones that can be used to improve the character skills and powers.",
    "author": "MagicalAlexey, Spinoraptor, Linnett, Cucuber, Samuelchik, Max_Sleep, Rezolv and many others.",
    "websiteURL": "https://modrinth.com/mod/keepers-of-the-stones-2",
    "license": "GNU General Public License version 3 (GPLv3)",
    "serverSideOnly": false,
    "modPicture": "logo",
    "requiredMods": [
      "curios",
      "abloom"
    ],
    "dependencies": [
      "bettercombat",
      "patchouli"
    ],
